# GAS Web App URL (deploy → ウェブアプリ → URL)
GAS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# LIFFアプリのID（SETUP.md STEP 6で発行される値。未設定のまま公開すると、お客様画面が
# 貝屋和光の本番LIFFへ接続し続けてしまうため、他店舗へ導入する場合は必ず設定すること）
NEXT_PUBLIC_LIFF_ID=YOUR_LIFF_ID

# LINEの「チャンネル基本設定」にあるチャンネルシークレット（Messaging APIのアクセストークンとは別物）。
# 未設定でも動作するが、/api/line-webhookの署名検証をスキップする状態になるため設定を推奨（SETUP.md STEP 5）
LINE_CHANNEL_SECRET=YOUR_CHANNEL_SECRET
